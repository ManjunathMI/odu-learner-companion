# Copy to .env.local and replace placeholders. Never commit real credentials.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
NEXT_PUBLIC_BASE_URL=http://localhost:3000
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-key
# Set BOTH owner values from the confirmed Auth user for a new installation.
PLATFORM_OWNER_ID=your-owner-auth-user-uuid
PLATFORM_OWNER_EMAIL=owner@example.com
