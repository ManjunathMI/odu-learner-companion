# Copy to .env.local and replace placeholders. Never commit real credentials.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
NEXT_PUBLIC_BASE_URL=http://localhost:3000
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-key
# Set BOTH owner values from the confirmed Auth user for a new installation.
PLATFORM_OWNER_ID=your-owner-auth-user-uuid
PLATFORM_OWNER_EMAIL=owner@example.com

# Optional transactional email for application notifications. Leave disabled until configured.
# Supported providers: resend, brevo. The Vercel Resend integration can supply RESEND_API_KEY.
NOTIFICATION_EMAIL_PROVIDER=disabled
NOTIFICATION_EMAIL_FROM=
NOTIFICATION_EMAIL_FROM_NAME=ODU Learner Companion
NOTIFICATION_EMAIL_API_KEY=
# Stable server-only random secret, at least 32 characters. See the installation guide.
PATH_INVITATION_SECRET=
