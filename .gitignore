# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# private design materials
/designDocs/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local agent skills and connector configuration (never application source)
/.agents/
/.codex/
/.claude/
/.continue/
/CLAUDE.md
/skills-lock.json
/.mcp.json
/mcp.json
/.vscode/

# Local auth links, sessions, reports, and Supabase CLI state
/.local/
/test-results/
/playwright-report/
/blob-report/
/supabase/.temp/
/supabase/.branches/

# Safe installation template (all actual environment files remain ignored)
!/.env.example
